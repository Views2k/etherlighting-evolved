<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EtherlightingEvolved</AssemblyName>
    <RootNamespace>EtherlightingEvolved</RootNamespace>
    <Version>0.5.0</Version>
    <Authors>Views2k</Authors>
    <Company>Views2k</Company>
    <Product>Etherlighting Evolved</Product>
    <Description>Lighting controls for UniFi switches</Description>
    <ApplicationIcon>../src/etherlighting_evolved/assets/ee.ico</ApplicationIcon>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../assets/logo.png" Link="Assets/logo.png" />
    <Resource Include="../src/etherlighting_evolved/assets/ee.ico" Link="Assets/ee.ico" />
  </ItemGroup>
</Project>
