<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep downloaded packages inside the ignored outputs folder so they can be reviewed and removed together. -->
    <add key="globalPackagesFolder" value="../outputs/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
